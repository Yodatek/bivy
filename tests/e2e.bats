#!/usr/bin/env bats
# The whole path with real mise and default locations: init --config, apply, doctor,
# on a home that povy 0.1 had set up.

load helper

real_home_snapshot() {
  local f
  for f in .zshrc .zshenv .zprofile .bashrc .bash_profile .profile .gitconfig .config/git/config \
    .ssh/config .m2/settings.xml .config/povy/config.toml .config/povy/.env .config/povy/env.sh \
    .config/mise/config.toml .config/mise/conf.d/povy.toml .local/state/povy/applied \
    Library/LaunchAgents/povy.env.plist .config/environment.d/50-povy.conf; do
    if [ -e "$REAL_HOME/$f" ]; then
      printf '%s %s\n' "$f" "$(cksum <"$REAL_HOME/$f")"
    else
      printf '%s absent\n' "$f"
    fi
  done
  if [ -x /bin/launchctl ]; then
    printf 'launchctl PATH=%s\n' "$(/bin/launchctl getenv PATH)"
  fi
}

setup_file() {
  export REAL_HOME=$HOME
  real_home_snapshot >"$BATS_FILE_TMPDIR/real-before"
  sandbox_env "$BATS_FILE_TMPDIR/home"
  make_profile_repo "$BATS_FILE_TMPDIR/profile"
  write_config "$BATS_FILE_TMPDIR/config.toml" "$BATS_FILE_TMPDIR/profile"
  printf '# mine\nexport MINE=1\n' >"$HOME/.zshenv"
  # The mise config that povy 0.1 generated, with the tools it read.
  mkdir -p "$HOME/.config/mise/conf.d"
  printf '# Generated by povy apply.\n[tools]\n"jq" = "1.6"\n' >"$HOME/.config/mise/conf.d/povy.toml"

  povy init --config "$BATS_FILE_TMPDIR/config.toml"
  echo 'EXAMPLE_API_TOKEN=s3cret&\value' >>"$HOME/.config/povy/.env"
  povy apply >"$BATS_FILE_TMPDIR/apply.log" 2>&1
}

setup() {
  export HOME=$BATS_FILE_TMPDIR/home
}

@test "doctor passes after init --config and apply" {
  run povy doctor
  echo "$output"
  [ "$status" -eq 0 ]
  [[ "$output" == *"[ok]   mise bootstrap: the profile's mise.toml is applied"* ]] || false
  [[ "$output" == *"povy doctor: all good."* ]] || false
  [[ "$output" != *"FAIL"* ]] || false
}

@test "secrets file has mode 600" {
  [ "$(file_mode "$HOME/.config/povy/.env")" = 600 ]
}

@test "mise renders the profile's template in mode 600, with the secret verbatim" {
  local target="$HOME/.config/povy-example/example.conf"
  [ "$(file_mode "$target")" = 600 ]
  grep -qxF 'token = s3cret&\value' "$target"
}

@test "the secret is only in .env and in the file mise renders" {
  run grep -rlF 's3cret' "$HOME"
  [ "$(printf '%s\n' "$output" | LC_ALL=C sort)" = "$(printf '%s\n' \
    "$HOME/.config/povy-example/example.conf" "$HOME/.config/povy/.env" | LC_ALL=C sort)" ]
}

@test "the secret never appears in the output" {
  ! grep -qF 's3cret' "$BATS_FILE_TMPDIR/apply.log" || false
  run povy doctor
  [[ "$output" != *s3cret* ]] || false
}

@test "the mise config of povy 0.1 is replaced, and backed up" {
  local conf=$HOME/.config/mise/conf.d/povy.toml found
  grep -qxF "include = [\"$HOME/.local/state/povy/profile/team.toml\"]" "$conf"
  ! grep -qF '"jq"' "$conf" || false
  found=$(find "$HOME/.local/state/povy/backups" -path '*/conf.d/povy.toml')
  [ -n "$found" ]
  grep -qxF '"jq" = "1.6"' "$found"
  [ "$(file_mode "$found")" = 600 ]
}

@test "a changed startup file is backed up with its content" {
  local found
  found=$(find "$HOME/.local/state/povy/backups" -name .zshenv)
  [ -n "$found" ]
  [ "$(cat "$found")" = $'# mine\nexport MINE=1' ]
  [ "$(file_mode "$found")" = 600 ]
}

@test "existing startup content is kept, below the block" {
  grep -qxF 'export MINE=1' "$HOME/.zshenv"
  [ "$(head -n 1 "$HOME/.zshenv")" = '# >>> povy >>>' ]
}

@test "the tools of team.toml run from non-interactive shells with an empty environment" {
  cd "$HOME"
  run env -i HOME="$HOME" PATH=/usr/bin:/bin bash -lc 'jq --version'
  [ "$status" -eq 0 ]
  [ "$output" = jq-1.7.1 ]
  if command -v zsh >/dev/null; then
    run env -i HOME="$HOME" PATH=/usr/bin:/bin zsh -c 'jq --version'
    [ "$status" -eq 0 ]
    [ "$output" = jq-1.7.1 ]
  fi
}

@test "shims come first in a login shell even when PATH already has them late" {
  cd "$HOME"
  run env -i HOME="$HOME" PATH="/usr/bin:/bin:$HOME/.local/share/mise/shims" bash -lc 'command -v jq'
  [ "$output" = "$HOME/.local/share/mise/shims/jq" ]
}

@test "a second apply writes nothing, adds no backup and leaves the home as it was" {
  local before after backups_before backups_after
  before=$(home_fingerprint)
  backups_before=$(ls "$HOME/.local/state/povy/backups")
  run povy apply
  [ "$status" -eq 0 ]
  [[ "$output" == *"Applied: 0 written"*"0 backed up"* ]] || false
  after=$(home_fingerprint)
  backups_after=$(ls "$HOME/.local/state/povy/backups")
  [ "$before" = "$after" ]
  [ "$backups_before" = "$backups_after" ]
}

@test "the Git identity comes from config.toml" {
  cd "$HOME"
  [ "$(git config --global --includes --get user.email)" = test@example.org ]
  [ "$(git config --global --includes --get user.name)" = "Test User" ]
}

@test "on macOS, apply sets the GUI PATH through the stub, never the real launchctl" {
  [ -s "$BATS_FILE_TMPDIR/launchctl/calls" ] || [ "$(uname -s)" != Darwin ]
}

@test "no temporary file is left behind" {
  [ "$(ls -A "$HOME/.local/state/povy" | tr '\n' ' ')" = "applied backups profile " ]
  [ "$(ls -A "$HOME/.config/povy" | tr '\n' ' ')" = ".env config.toml env.sh git interactive.sh " ]
  [ -z "$(find "$HOME" -name '.povy.*' -print)" ]
}

@test "the real home is untouched" {
  HOME=$REAL_HOME real_home_snapshot >"$BATS_FILE_TMPDIR/real-after"
  cmp "$BATS_FILE_TMPDIR/real-before" "$BATS_FILE_TMPDIR/real-after"
}
