#!/usr/bin/env bash
# Entry point: resolves the engine directory, then dispatches to lib/cmd/*.
set -euo pipefail

src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir=$(cd -P "$(dirname "$src")" && pwd)
  src=$(readlink "$src")
  case "$src" in
    /*) ;;
    *) src="$dir/$src" ;;
  esac
done
POVY_ROOT=$(cd -P "$(dirname "$src")/.." && pwd)

# shellcheck source=lib/common.sh
. "$POVY_ROOT/lib/common.sh"
# shellcheck source=lib/config.sh
. "$POVY_ROOT/lib/config.sh"
# shellcheck source=lib/profile.sh
. "$POVY_ROOT/lib/profile.sh"
# shellcheck source=lib/shell.sh
. "$POVY_ROOT/lib/shell.sh"
# shellcheck source=lib/gui.sh
. "$POVY_ROOT/lib/gui.sh"
# shellcheck source=lib/git.sh
. "$POVY_ROOT/lib/git.sh"
# shellcheck source=lib/packages.sh
. "$POVY_ROOT/lib/packages.sh"

usage() {
  cat <<'EOF'
Usage: povy <command>

Commands:
  init [--config <file>]   Write ~/.config/povy/config.toml and .env
  apply                    Install tools, load shims, set the Git identity,
                           write profile files
  doctor                   Check the real state; exits 1 if something is wrong
  banner                   Show the tools, what does not work and the machine load
  tools                    List each tool, where it is declared and what mise runs
  version                  Show the version of povy
  help                     Show this message
EOF
}

command=${1:-help}
[ $# -eq 0 ] || shift

case "$command" in
  init | apply | doctor | banner | tools)
    # shellcheck source=/dev/null
    . "$POVY_ROOT/lib/cmd/$command.sh"
    "cmd_$command" "$@"
    ;;
  version | -V | --version) printf 'povy %s\n' "$(povy_version)" ;;
  help | -h | --help) usage ;;
  *)
    usage >&2
    die "unknown command: $command"
    ;;
esac
